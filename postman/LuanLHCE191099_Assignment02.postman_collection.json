{
  "info": {
    "name": "LuanLHCE191099 - Assignment 02 - Session login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests in order. Postman automatically retains the A2SESSION cookie. The pre-request script obtains the CSRF value before writes. Test records are removed near the end."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082/api"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('testRun')) {",
          "  const run=String(Date.now());",
          "  pm.collectionVariables.set('testRun',run);",
          "  pm.collectionVariables.set('testEmail','session.test.'+run+'@example.com');",
          "  pm.collectionVariables.set('testCategoryName','SessionCategory'+run);",
          "  pm.collectionVariables.set('testNewsTitle','SessionNews'+run);",
          "}",
          "if (['POST','PUT','PATCH','DELETE'].includes(pm.request.method)) {",
          "  pm.sendRequest({url:pm.variables.get('baseUrl')+'/auth/csrf',method:'GET'}, (error,response) => {",
          "    if (error || response.code !== 200) throw new Error('Cannot obtain CSRF protection value');",
          "    const csrf=response.json();",
          "    pm.request.headers.upsert({key:csrf.headerName,value:csrf.token});",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Read published news",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/public/news"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only active news\", () => pm.expect(pm.response.json().every(item => item.status === 1)).to.be.true);"
            ]
          }
        }
      ]
    },
